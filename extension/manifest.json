{
  "manifest_version": 3,
  "name": "Sincerely — Campaign Manager",
  "version": "0.1.0",
  "description": "Add and remove people from your Sincerely campaigns from LinkedIn, Gmail, or any page.",
  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://api.usesincerely.com/*",
    "https://www.linkedin.com/*",
    "https://mail.google.com/*"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sincerely — add to campaign",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://mail.google.com/*"
      ],
      "js": ["content/scraper.js"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Sincerely campaign manager"
    }
  }
}
