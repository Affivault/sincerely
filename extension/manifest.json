{
  "manifest_version": 3,
  "name": "Sincerely — Campaign Manager",
  "version": "0.1.0",
  "description": "Add and remove people from your Sincerely campaigns from LinkedIn, Gmail, or any page.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://skysend-api.onrender.com/*",
    "https://api.usesincerely.com/*",
    "https://www.linkedin.com/*",
    "https://mail.google.com/*",
    "https://usesincerely.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sincerely — open the sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/net-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "content/scraper.js",
        "content/list-select.js",
        "content/launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://usesincerely.com/*",
        "https://*.usesincerely.com/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "content/connect.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "content/act.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://mail.google.com/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open Sincerely campaign manager"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html?surface=sidepanel"
  }
}
